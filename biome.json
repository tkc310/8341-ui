{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "files": {
    "includes": ["**", "!dist", "!storybook-static", "!src/tokens/tokens.ts", "!src/tokens/tokens.json", "!src/styles/tokens.css", "!src/styles/typography.css"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true
      }
    }
  }
}
