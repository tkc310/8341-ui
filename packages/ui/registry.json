{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "8341-ui",
  "homepage": "https://github.com/tkc310/design-system-myself",
  "items": [
    {
      "name": "8341-base",
      "type": "registry:base",
      "title": "8341-ui base",
      "description": "8341-ui 0.1.0 の土台。ヘッドレス UI は Base UI に固定し、トークンとテーマを入れる",
      "config": {
        "style": "base-nova",
        "iconLibrary": "none",
        "rsc": true,
        "tailwind": {
          "cssVariables": true
        }
      },
      "dependencies": [
        "@base-ui/react@^1.9.0",
        "tailwind-variants@^3.3.0"
      ],
      "registryDependencies": [
        "@8341/tv",
        "@8341/theme"
      ]
    },
    {
      "name": "tv",
      "type": "registry:lib",
      "title": "tv / cn",
      "description": "8341-ui のテーマ名を登録した tailwind-variants と、フォーカス表示のクラス",
      "dependencies": [
        "tailwind-variants@^3.3.0"
      ],
      "files": [
        {
          "path": "src/lib/tv.ts",
          "type": "registry:lib"
        },
        {
          "path": "src/lib/tw-merge-config.ts",
          "type": "registry:lib"
        },
        {
          "path": "src/lib/focus.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "theme",
