{
  "name": "8341-ui",
  "version": "0.1.0",
  "description": "プロジェクトで使い回す自分用のデザインシステム（React + Base UI + Tailwind CSS v4 / アクセシビリティ優先）",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack && tailwindcss -i src/styles/build.css -o dist/styles.css --minify && tsx scripts/check-dist.ts",
    "check": "tsx scripts/audit-classes.ts && tsx scripts/generate-registry.ts --check",
    "test": "vp test --project unit",
    "test:vrt": "vp test --project vrt",
    "figma:publish": "figma connect publish",
    "registry": "tsx scripts/generate-registry.ts",
    "registry:build": "tsx scripts/build-registry-css.ts && shadcn build ./registry.json -o ../../apps/storybook/public/r"
  },
  "dependencies": {
    "8341-ui-tokens": "workspace:*",
    "@base-ui/react": "catalog:",
    "tailwind-variants": "catalog:"
  },
  "devDependencies": {
    "@figma/code-connect": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "catalog:",
    "happy-dom": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4.1"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "author": "Takashi Sato",
  "homepage": "https://tkc310.github.io/8341ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkc310/8341ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/tkc310/8341ui/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "base-ui",
    "tailwindcss",
    "shadcn",
    "accessibility",
    "wcag"
  ]
}
