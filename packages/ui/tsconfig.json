{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    // shadcn 方式で配布したときと同じ import パスで書く（利用側の components.json の aliases に合わせて CLI が書き換える）
    "paths": {
      "@/components/ui/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"]
    },
    "types": ["node", "@figma/code-connect/figma-types"]
  },
  "include": ["src", "scripts", "vite.config.ts", "vitest.setup.ts", "vitest.browser.setup.ts"]
}
