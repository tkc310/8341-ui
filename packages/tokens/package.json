{
  "name": "8341-ui-tokens",
  "version": "0.1.0",
  "description": "8341-ui のデザイントークン（DTCG 2025.10）と、そこから生成した CSS 変数・Tailwind v4 テーマ・Figma Variables",
  "keywords": [
    "accessibility",
    "design-tokens",
    "dtcg",
    "figma-variables",
    "style-dictionary",
    "tailwindcss"
  ],
  "homepage": "https://tkc310.github.io/8341ui/",
  "bugs": {
    "url": "https://github.com/tkc310/8341ui/issues"
  },
  "license": "MIT",
  "author": "Takashi Sato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkc310/8341ui.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/css/tokens.css",
    "./tailwind.css": "./dist/css/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./dtcg/*": "./src/*",
    "./figma/*": "./dist/figma/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.ts && node scripts/export-figma.ts",
    "palette": "node scripts/generate-palette.ts",
    "design-md": "node scripts/sync-design-md.ts",
    "figma": "node scripts/export-figma.ts",
    "check": "node scripts/check-contrast.ts && node scripts/sync-design-md.ts --check && node scripts/generate-tw-merge.ts --check",
    "check:contrast": "node scripts/check-contrast.ts",
    "test": "vp test",
    "audit": "node scripts/audit-report.ts",
    "tw-merge": "node scripts/generate-tw-merge.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "style-dictionary": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
