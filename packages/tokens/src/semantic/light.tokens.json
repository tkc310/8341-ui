{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Semantic colors — light theme. コンポーネントはこの層だけを参照する。キーは dark.tokens.json と完全一致させること（CI で検証）。",
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.primitive.white}",
        "$description": "ページ全体の背景"
      },
      "surface": {
        "$value": "{color.primitive.white}",
        "$description": "カード・入力欄など面の背景"
      },
      "subtle": {
        "$value": "{color.primitive.gray.50}",
        "$description": "区切りたい帯・コードブロック"
      },
      "muted": {
        "$value": "{color.primitive.gray.100}",
        "$description": "ホバー時の面・テーブル見出し"
      },
      "inverse": {
        "$value": "{color.primitive.gray.1100}"
      },
      "disabled": {
        "$value": "{color.primitive.gray.100}"
      },
      "key": {
        "$value": "{color.primitive.indigo.700}",
        "$description": "主要アクション（Primary ボタン）"
      },
      "key-hover": {
        "$value": "{color.primitive.indigo.800}"
      },
      "key-active": {
        "$value": "{color.primitive.indigo.900}"
      },
      "key-subtle": {
        "$value": "{color.primitive.indigo.100}",
        "$description": "選択中の項目・Secondary ボタンの hover"
      },
      "key-subtle-hover": {
        "$value": "{color.primitive.indigo.200}"
      },
      "danger": {
        "$value": "{color.primitive.red.700}"
      },
      "danger-hover": {
        "$value": "{color.primitive.red.800}"
      },
      "danger-active": {
        "$value": "{color.primitive.red.900}"
      },
      "danger-subtle": {
        "$value": "{color.primitive.red.50}"
      },
      "success-subtle": {
        "$value": "{color.primitive.green.50}"
      },
      "warning-subtle": {
        "$value": "{color.primitive.yellow.50}"
      },
      "info-subtle": {
        "$value": "{color.primitive.indigo.50}"
      },
      "overlay": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0392,
            0.0471,
            0.0784
          ],
          "alpha": 0.48,
          "hex": "#0a0c14"
        },
        "$description": "モーダル背面"
      }
    },
    "text": {
      "default": {
        "$value": "{color.primitive.gray.1100}",
        "$description": "本文。純黒は使わない"
      },
      "subtle": {
        "$value": "{color.primitive.gray.700}",
        "$description": "補足・説明文（4.5:1 以上）"
      },
      "disabled": {
        "$value": "{color.primitive.gray.500}",
        "$description": "無効状態（WCAG のコントラスト要件対象外だが 3:1 を目安）"
      },
      "inverse": {
        "$value": "{color.primitive.gray.50}"
      },
      "key": {
        "$value": "{color.primitive.indigo.800}",
        "$description": "キーカラーの文字（Secondary ボタン等）"
      },
      "on-key": {
        "$value": "{color.primitive.white}",
        "$description": "bg.key / bg.danger の上の文字"
      },
      "danger": {
        "$value": "{color.primitive.red.800}"
      },
      "success": {
        "$value": "{color.primitive.green.800}"
      },
      "warning": {
        "$value": "{color.primitive.orange.800}"
