      "link-visited": {
        "$value": "{color.primitive.purple.800}"
      },
      "link-active": {
        "$value": "{color.primitive.orange.800}"
      }
    },
    "icon": {
      "default": {
        "$value": "{color.primitive.gray.1000}"
      },
      "subtle": {
        "$value": "{color.primitive.gray.700}"
      },
      "key": {
        "$value": "{color.primitive.indigo.700}"
      },
