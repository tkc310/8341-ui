      },
      "key": {
        "$value": "{color.primitive.indigo.700}"
      },
      "danger": {
        "$value": "{color.primitive.red.700}"
      },
      "success": {
        "$value": "{color.primitive.green.700}"
      },
      "warning": {
        "$value": "{color.primitive.yellow.600}"
      },
      "disabled": {
        "$value": "{color.primitive.gray.300}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.primitive.yellow.300}",
        "$description": "フォーカスの内側リング"
      },
      "outline": {
        "$value": "{color.primitive.gray.1200}",
