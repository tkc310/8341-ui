    "display-lg": {
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.family.sans}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{font.size.56}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.bold}"
      },
      "line-height": {
        "$type": "number",
        "$value": "{font.line-height.140}"
      },
      "letter-spacing": {
        "$type": "number",
        "$value": "{font.letter-spacing.none}"
      }
    },
