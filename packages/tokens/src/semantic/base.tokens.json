  "space": {
    "$type": "dimension",
    "$description": "inset/gap はコンポーネント内部用（4px 刻み）。stack はレイアウト用で 3 値に限定する（1× / 3× / 8×）。",
    "inset-xs": {
      "$value": "{dimension.4}"
    },
    "inset-sm": {
      "$value": "{dimension.8}"
    },
    "inset-md": {
      "$value": "{dimension.12}"
    },
    "inset-lg": {
      "$value": "{dimension.16}"
    },
    "inset-xl": {
      "$value": "{dimension.24}"
    },
    "gap-xs": {
      "$value": "{dimension.4}"
    },
    "gap-sm": {
      "$value": "{dimension.8}"
    },
    "gap-md": {
      "$value": "{dimension.16}"
    },
    "stack-sm": {
      "$value": "{dimension.8}",
      "$description": "密接に関係する要素（ラベルと入力欄）"
    },
    "stack-md": {
      "$value": "{dimension.24}",
      "$description": "同じグループ内の要素（フォーム項目同士）"
    },
    "stack-lg": {
      "$value": "{dimension.64}",
      "$description": "セクション間"
    },
    "gutter": {
      "$value": "{dimension.32}",
      "$description": "グリッドのガター（本文サイズ × 2）"
    },
    "page-inline": {
      "$value": "{dimension.16}",
      "$description": "モバイル時の左右余白。md 以上は 32px"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "横長の要素ほど小さい角丸を選ぶ（同じ値でも横長だと丸く見えるため）。",
    "none": {
      "$value": "{dimension.0}"
    },
    "xs": {
      "$value": "{dimension.4}",
      "$description": "チェックボックス・タグ"
    },
    "sm": {
      "$value": "{dimension.6}",
      "$description": "小さいボタン"
    },
    "md": {
      "$value": "{dimension.8}",
      "$description": "ボタン・入力欄"
    },
    "lg": {
      "$value": "{dimension.12}",
      "$description": "バナー・横長カード"
    },
    "xl": {
      "$value": "{dimension.16}",
      "$description": "カード・ダイアログ"
    },
    "full": {
      "$value": "{dimension.full}",
      "$description": "ピル形・円"
    }
  },
  "size": {
    "$type": "dimension",
    "control-sm": {
      "$value": "{dimension.36}",
      "$description": "小さいコントロールの見た目の高さ（タップ領域は 44px を別途確保）"
    },
    "control-md": {
      "$value": "{dimension.44}",
      "$description": "標準。見た目の高さ＝最小タップ領域"
    },
    "control-lg": {
      "$value": "{dimension.52}"
    },
    "target-min": {
      "$value": "{dimension.44}",
      "$description": "WCAG 2.5.5 のタップ領域"
    },
    "icon-sm": {
      "$value": "{dimension.16}"
    },
    "icon-md": {
      "$value": "{dimension.20}"
    },
    "icon-lg": {
      "$value": "{dimension.24}"
    },
    "content-max": {
      "$value": {
        "value": 1200,
        "unit": "px"
      },
      "$description": "コンテンツ最大幅"
    },
    "prose-max": {
      "$value": {
        "value": 720,
        "unit": "px"
      },
      "$description": "本文の最大幅（和文で 1 行 40〜45 字）"
    }
  },
  "border-width": {
    "$type": "dimension",
    "default": {
      "$value": "{dimension.1}"
    },
    "strong": {
      "$value": "{dimension.2}"
    },
    "accent": {
      "$value": "{dimension.4}",
      "$description": "見出しのバー・バナーの左線"
    },
    "underline": {
      "$value": "{dimension.1}",
      "$description": "リンクの下線"
    },
    "underline-hover": {
      "$value": "{dimension.3}",
      "$description": "ホバー時のリンク下線（太さで状態変化を示す）"
    }
  },
  "focus": {
    "$type": "dimension",
    "outline-width": {
      "$value": "{dimension.2}"
    },
    "ring-width": {
      "$value": "{dimension.4}",
      "$description": "outline-offset 分を含む box-shadow の広がり"
    },
    "offset": {
      "$value": "{dimension.2}"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.fast}"
      },
      "base": {
        "$value": "{duration.base}"
      },
      "slow": {
        "$value": "{duration.slow}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.standard}"
      },
      "enter": {
        "$value": "{easing.enter}"
      },
      "exit": {
        "$value": "{easing.exit}"
      }
    }
  },
  "z": {
    "$type": "number",
    "dropdown": {
      "$value": 100
    },
    "sticky": {
      "$value": 200
    },
    "overlay": {
      "$value": 300
    },
    "modal": {
      "$value": 400
    },
    "toast": {
      "$value": 500
    }
  }
}
