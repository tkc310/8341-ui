{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Primitive typography. 値の素材であり、コンポーネントから直接参照しない（semantic の text style を使う）。",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Noto Sans JP",
          "-apple-system",
          "BlinkMacSystemFont",
          "Hiragino Sans",
          "sans-serif"
        ],
        "$description": "Web フォントが読めなくても情報が伝わるよう OS 標準の和文ゴシックへフォールバックする"
      },
      "mono": {
        "$value": [
          "Noto Sans Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "14 未満は定義しない。CSS では rem に変換して出力する（ユーザーの文字サイズ設定に追従）",
      "14": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "16": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "18": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "20": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "24": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "28": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "32": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      },
      "36": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      },
      "44": {
        "$value": {
          "value": 44,
          "unit": "px"
        }
      },
      "56": {
        "$value": {
          "value": 56,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "bold": {
        "$value": 700
      },
      "$description": "400 と 700 の 2 種類のみ"
    },
    "line-height": {
      "$type": "number",
      "100": {
        "$value": 1
      },
      "120": {
        "$value": 1.2
      },
      "130": {
        "$value": 1.3
      },
      "140": {
        "$value": 1.4
      },
      "150": {
        "$value": 1.5
      },
      "160": {
        "$value": 1.6
      },
      "170": {
        "$value": 1.7
      },
      "180": {
        "$value": 1.8
      }
    },
    "letter-spacing": {
      "$type": "number",
      "$description": "字間。値は文字サイズに対する比率（CSS では em を付けて出力する）。DTCG の dimension は px と rem しか許さず、文字サイズに比例する字間を表せないため number で持つ",
      "none": {
        "$value": 0
      },
      "tight": {
        "$value": 0.01
      },
      "normal": {
        "$value": 0.02
      },
      "wide": {
        "$value": 0.04
      }
    }
  }
}
