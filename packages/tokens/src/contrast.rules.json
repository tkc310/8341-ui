{
  "$description": "semantic カラーの組み合わせごとに必要なコントラスト比。両テーマで検証される（pnpm --filter 8341-ui-tokens check:contrast）。新しい semantic カラーを足したら必ずここにも組み合わせを足す。",
  "rules": [
    {
      "id": "text-on-surfaces",
      "fg": [
        "color.text.default",
        "color.text.subtle",
        "color.text.key",
        "color.text.danger",
        "color.text.success",
        "color.text.warning",
        "color.text.link",
        "color.text.link-hover",
        "color.text.link-visited",
        "color.text.link-active"
      ],
      "bg": ["color.bg.canvas", "color.bg.surface", "color.bg.subtle"],
      "min": 4.5,
      "wcag": "1.4.3"
    },
    {
      "id": "text-on-muted",
      "fg": ["color.text.default", "color.text.subtle"],
      "bg": ["color.bg.muted", "color.bg.key-subtle"],
      "min": 4.5,
      "wcag": "1.4.3"
    },
    {
      "id": "text-on-hover-selection",
      "pairs": [
        ["color.text.default", "color.bg.key-subtle-hover"],
        ["color.text.key", "color.bg.key-subtle-hover"]
      ],
      "min": 4.5,
      "wcag": "1.4.3"
    },
    {
      "id": "key-text-on-key-subtle",
      "fg": ["color.text.key"],
      "bg": ["color.bg.key-subtle", "color.bg.key-subtle-hover", "color.bg.info-subtle"],
      "min": 4.5,
      "wcag": "1.4.3"
    },
    {
      "id": "status-text-on-status-bg",
      "pairs": [
        ["color.text.danger", "color.bg.danger-subtle"],
        ["color.text.success", "color.bg.success-subtle"],
        ["color.text.warning", "color.bg.warning-subtle"],
        ["color.text.default", "color.bg.danger-subtle"],
        ["color.text.default", "color.bg.success-subtle"],
        ["color.text.default", "color.bg.warning-subtle"],
        ["color.text.default", "color.bg.info-subtle"]
      ],
      "min": 4.5,
      "wcag": "1.4.3"
    },
    {
      "id": "on-key",
      "fg": ["color.text.on-key"],
      "bg": [
        "color.bg.key",
        "color.bg.key-hover",
        "color.bg.key-active",
        "color.bg.danger",
        "color.bg.danger-hover",
        "color.bg.danger-active"
      ],
      "min": 4.5,
      "wcag": "1.4.3"
    },
    {
      "id": "inverse",
      "pairs": [["color.text.inverse", "color.bg.inverse"]],
      "min": 4.5,
      "wcag": "1.4.3"
    },
    {
      "id": "ui-boundaries",
      "fg": [
        "color.border.default",
        "color.border.input",
        "color.border.strong",
        "color.border.key",
        "color.border.danger",
        "color.border.success",
        "color.border.warning"
      ],
      "bg": ["color.bg.canvas", "color.bg.surface"],
      "min": 3,
      "wcag": "1.4.11"
    },
    {
      "id": "icons",
      "fg": [
        "color.icon.default",
        "color.icon.subtle",
        "color.icon.key",
        "color.icon.danger",
        "color.icon.success",
        "color.icon.warning",
        "color.icon.info"
      ],
      "bg": ["color.bg.canvas", "color.bg.surface"],
      "min": 4.5,
      "wcag": "1.4.11 (テキストに隣接するアイコンは 4.5:1 とする独自基準)"
    },
    {
      "id": "status-icons-on-status-bg",
      "pairs": [
        ["color.icon.danger", "color.bg.danger-subtle"],
        ["color.icon.success", "color.bg.success-subtle"],
        ["color.icon.warning", "color.bg.warning-subtle"],
        ["color.icon.info", "color.bg.info-subtle"]
      ],
      "min": 3,
      "wcag": "1.4.11"
    },
    {
      "id": "switch-thumb",
      "$description": "Switch のつまみとトラック。オフのつまみは枠線の色、オンのつまみは面の色を key の上に置く（ホバー時を含む）",
      "pairs": [
        ["color.border.input", "color.bg.muted"],
        ["color.border.strong", "color.bg.muted"],
        ["color.bg.surface", "color.bg.key"],
        ["color.bg.surface", "color.bg.key-hover"]
      ],
      "min": 3,
      "wcag": "1.4.11"
    },
    {
      "id": "key-bg-as-boundary",
      "fg": ["color.bg.key", "color.bg.danger"],
      "bg": ["color.bg.canvas"],
      "min": 3,
      "wcag": "1.4.11"
    },
    {
      "id": "focus-indicator",
      "fg": ["color.focus.outline"],
      "bg": ["color.bg.canvas", "color.bg.surface", "color.bg.subtle", "color.bg.muted"],
      "min": 3,
      "wcag": "2.4.13（外側のアウトラインが常に周囲の背景と 3:1 以上になるようにする。内側の黄色リングは暗い要素上での補助）"
    },
    {
      "id": "link-vs-text",
      "pairs": [["color.text.link", "color.text.default"]],
      "min": 1,
      "wcag": "1.4.1（リンクは下線必須なので色差は要求しない。記録用）"
    },
    {
      "id": "disabled-legibility",
      "fg": ["color.text.disabled"],
      "bg": ["color.bg.disabled", "color.bg.canvas"],
      "min": 2.5,
      "wcag": "対象外（独自の下限）"
    },
    {
      "id": "text-on-focus-ring",
      "pairs": [["color.focus.text", "color.focus.ring"]],
      "min": 4.5,
      "wcag": "1.4.3"
    }
  ]
}
