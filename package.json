{
  "name": "8341-ui-monorepo",
  "private": true,
  "description": "8341-ui のモノレポ（トークン / コンポーネント / Storybook / レジストリ）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkc310/8341-ui.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "pnpm build:tokens",
    "build:tokens": "pnpm --filter 8341-ui-tokens build",
    "dev": "pnpm build:tokens && pnpm --filter 8341-ui-storybook dev",
    "build": "pnpm build:tokens && pnpm --filter 8341-ui build",
    "build:storybook": "pnpm build:tokens && pnpm --filter 8341-ui-storybook build",
    "storybook:preview": "pnpm build:storybook && pnpm --filter 8341-ui-storybook preview:publish",
    "check": "pnpm build:tokens && vp check && vp run -r check && depcruise packages apps && node scripts/slides/check.ts && node scripts/check-skills.ts",
    "test": "pnpm build:tokens && vp run -r test",
    "test:vrt": "pnpm build:tokens && pnpm --filter 8341-ui test:vrt",
    "test:e2e": "pnpm build:tokens && pnpm --filter 8341-ui-storybook test:e2e",
    "audit:report": "pnpm --filter 8341-ui-tokens audit",
    "changeset": "changeset",
    "factory:create": "node scripts/factory/create.mjs",
    "release:version": "node scripts/release.mjs version",
    "release:publish": "node scripts/release.mjs publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "dependency-cruiser": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    }
  }
}
