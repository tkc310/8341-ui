{
  "name": "design-system-myself",
  "version": "0.1.0",
  "description": "プロジェクトで使い回す自分用のデザインシステム（React + TypeScript / アクセシビリティ優先）",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/design-system-myself.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./tokens.json": "./src/tokens/tokens.json"
  },
  "files": ["dist", "src/styles/tokens.css", "src/tokens/tokens.json", "DESIGN.md"],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "npm run tokens:build && vite build",
    "build-storybook": "storybook build",
    "tokens:palette": "tsx scripts/generate-palette.ts",
    "tokens:build": "tsx scripts/build-tokens.ts && tsx scripts/sync-design-md.ts",
    "check": "npm run check:tokens && npm run check:contrast && npm run check:css && npm run check:design-md && npm run typecheck && npm run lint",
    "check:tokens": "tsx scripts/build-tokens.ts --check",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:css": "tsx scripts/audit-css.ts",
    "check:design-md": "tsx scripts/sync-design-md.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "tsx scripts/audit-report.ts"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/addon-vitest": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^3.2.4",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
