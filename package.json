{
  "name": "tkc310-ui-monorepo",
  "private": true,
  "type": "module",
  "description": "tkc310-ui のモノレポ（トークン / コンポーネント / Storybook / レジストリ）",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.12.0"
    }
  },
  "scripts": {
    "prepare": "pnpm build:tokens",
    "build:tokens": "pnpm --filter tkc310-ui-tokens build",
    "dev": "pnpm build:tokens && pnpm --filter tkc310-ui-storybook dev",
    "build": "pnpm build:tokens && pnpm --filter tkc310-ui build",
    "build:storybook": "pnpm build:tokens && pnpm --filter tkc310-ui-storybook build",
    "check": "pnpm build:tokens && vp check && vp run -r check && depcruise packages apps",
    "test": "pnpm build:tokens && vp run -r test",
    "test:vrt": "pnpm build:tokens && pnpm --filter tkc310-ui test:vrt",
    "test:e2e": "pnpm build:tokens && pnpm --filter tkc310-ui-storybook test:e2e",
    "audit:report": "pnpm --filter tkc310-ui-tokens audit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "dependency-cruiser": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
