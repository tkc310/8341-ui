{
  // リポジトリ全体の解決用（dependency-cruiser が @/components/ui/* などを辿るため）。型検査は各パッケージの tsconfig で行う
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/components/ui/*": ["./packages/ui/src/components/ui/*"],
      "@/lib/*": ["./packages/ui/src/lib/*"],
      "@/test/*": ["./packages/ui/src/test/*"]
    }
  },
  "files": []
}
