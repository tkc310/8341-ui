{
  "$description": "Primitive typography. 値の素材であり、コンポーネントから直接参照しない（semantic の text style を使う）。",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Noto Sans JP", "-apple-system", "BlinkMacSystemFont", "Hiragino Sans", "sans-serif"],
        "$description": "Web フォントが読めなくても情報が伝わるよう OS 標準の和文ゴシックへフォールバックする"
      },
      "mono": {
        "$value": ["Noto Sans Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "px 指定は rem に変換して出力される（ユーザーの文字サイズ設定に追従）。14 未満は定義しない。",
      "14": { "$value": "14px" },
      "16": { "$value": "16px" },
      "18": { "$value": "18px" },
      "20": { "$value": "20px" },
      "24": { "$value": "24px" },
      "28": { "$value": "28px" },
      "32": { "$value": "32px" },
      "36": { "$value": "36px" },
      "44": { "$value": "44px" },
      "56": { "$value": "56px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "100": { "$value": 1 },
      "120": { "$value": 1.2 },
      "130": { "$value": 1.3 },
      "140": { "$value": 1.4 },
      "150": { "$value": 1.5 },
      "160": { "$value": 1.6 },
      "170": { "$value": 1.7 },
      "180": { "$value": 1.8 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "none": { "$value": "0em" },
      "tight": { "$value": "0.01em" },
      "normal": { "$value": "0.02em" },
      "wide": { "$value": "0.04em" }
    }
  }
}
